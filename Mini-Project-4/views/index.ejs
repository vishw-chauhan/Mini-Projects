<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>All Posts</h1>

    <% for (let post of posts) { %>

        <div class="post">
            <h3>@<%= post.username %></h3>
            <h4><%= post.content %></h4>

            <a href="http://localhost:3000/posts/<%=post.id%>">Show in details</a>

            <a href="/posts/<%= post.id %>/edit"><button>Edit Post</button></a>


            
    <a href="http://localhost:3000/posts/new"><button>Create Post</button></a>


    <form action="/posts/<%= post.id %>?_method=DELETE" method="post"> <button>Delete post</button>Delete post</form>
        </div>

    <% } %>



</body>
</html>