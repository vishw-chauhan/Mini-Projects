<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit User</title>

</head>

<body>

    <h1>Edit User</h1>

    <h2>
        Change Username and Password
    </h2>

    <p>
        Email:
        <strong><%= user.email %></strong>
    </p>


    <form
        action="/show/<%= user.id %>/edit?_method=PATCH"
        method="POST"
    >

        <label>Username:</label>

        <br>

        <input
            type="text"
            name="username"
            value="<%= user.username %>"
            required
        >

        <br><br>


        <label>Password:</label>

        <br>

        <input
            type="text"
            name="password"
            value="<%= user.password %>"
            required
        >

        <br><br>


        <button type="submit">
            Update User
        </button>

    </form>


    <br>

    <a href="/show">
        <button>
            Back to Users
        </button>
    </a>

</body>

</html>